---
import WhatsappIcon from "./icons/WhatsappIcon.astro";
import { whatsappUrl } from "../data/company";
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed right-5 bottom-5 z-40 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_12px_30px_-8px_rgb(37_211_102/0.6)] transition duration-300 hover:scale-105 hover:bg-[#1EBE5A] md:right-6 md:bottom-6"
  aria-label="Contactar por WhatsApp"
>
  <WhatsappIcon class="size-7" />

  <!-- Tooltip que aparece al hacer hover -->
  <span
    class="pointer-events-none absolute right-full mr-3 hidden rounded-lg bg-primary-900 px-3 py-2 font-display text-sm font-bold whitespace-nowrap text-white opacity-0 shadow-lg transition-opacity duration-300 group-hover:opacity-100 md:block"
  >
    ¡Hablemos de tu proyecto!
  </span>
</a>
