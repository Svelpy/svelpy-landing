---
// About.astro — Sección "Nosotros"
import { companyInfo, companyValues } from "../data/company";
import SectionHeading from "./SectionHeading.astro";
import { icons } from "./icons";
import MapPinIcon from "./icons/MapPinIcon.astro";

const pillars = [
  { label: "Misión", text: companyInfo.mision },
  { label: "Visión", text: companyInfo.vision },
];
---

<section
  id="nosotros"
  class="border-t border-primary-100 py-24 md:py-32"
  aria-labelledby="nosotros-title"
>
  <div class="container-page">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div>
        <SectionHeading
          id="nosotros-title"
          eyebrow="05 — Nosotros"
          title="Quiénes somos"
          description={companyInfo.about}
        />
        <p
          class="mt-8 inline-flex items-center gap-2 font-mono text-sm text-primary-600"
          data-reveal
        >
          <MapPinIcon class="size-4 text-secondary-600" />
          {companyInfo.location}
        </p>
      </div>

      <div class="grid gap-5">
        {
          pillars.map((pillar, index) => (
            <div
              class="rounded-2xl border border-primary-200 bg-white p-7"
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <p class="eyebrow text-secondary-600">{pillar.label}</p>
              <p class="mt-4 leading-relaxed text-primary-700">{pillar.text}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Valores -->
    <!-- <div class="mt-20 grid gap-px overflow-hidden rounded-2xl border border-primary-200 bg-primary-200 md:grid-cols-3">
      {
        companyValues.map((value, index) => {
          const Icon = icons[value.icon];
          return (
            <div
              class="bg-white p-7 md:p-8"
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <span class="inline-flex size-11 items-center justify-center rounded-xl bg-primary-900 text-secondary">
                <Icon class="size-5" />
              </span>
              <h3 class="mt-5 text-xl text-primary-900">{value.title}</h3>
              <p class="mt-2 leading-relaxed text-primary-600">
                {value.description}
              </p>
            </div>
          );
        })
      }
    </div> -->
  </div>
</section>
