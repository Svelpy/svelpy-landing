---
// About.astro — Sección "Nosotros" (declaración + misión y visión en columnas)
import { companyInfo } from "../data/company";
import MapPinIcon from "./icons/MapPinIcon.astro";

const pillars = [
  { label: "Misión", text: companyInfo.mision },
  { label: "Visión", text: companyInfo.vision },
];
---

<section
  id="nosotros"
  class="relative isolate overflow-clip border-t border-white/10 bg-primary-950 py-24 md:py-36"
  aria-labelledby="nosotros-title"
>
  <!-- Halo de fondo -->
  <div
    class="glow absolute -right-80 -bottom-60 -z-10 size-200 opacity-50"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <div class="flex flex-wrap items-center justify-between gap-4" data-reveal>
      <h2 id="nosotros-title" class="eyebrow text-secondary">05 — Nosotros</h2>
      <p
        class="inline-flex items-center gap-2 font-mono text-sm text-primary-400"
      >
        <MapPinIcon class="size-4 text-secondary" />
        {companyInfo.location}
      </p>
    </div>

    <!-- Declaración: las palabras se iluminan al hacer scroll -->
    <p
      data-highlight
      class="mt-10 max-w-5xl font-display text-3xl leading-[1.15] font-medium tracking-[-0.03em] text-white sm:text-4xl md:mt-14 lg:text-6xl"
    >
      {companyInfo.about}
    </p>

    <div class="mt-20 grid md:mt-28 md:grid-cols-2">
      {
        pillars.map((pillar, index) => (
          <div
            class:list={[
              "pt-10 md:pt-12",
              index === 0
                ? "md:pr-12 lg:pr-20"
                : "mt-12  md:mt-0  md:pl-12 lg:pl-20",
            ]}
            data-reveal
          >
            <h3 class="text-sm font-medium tracking-[0.14em] text-secondary uppercase">
              {pillar.label}
            </h3>
            <p class="mt-6 text-lg leading-relaxed text-primary-300 md:text-xl">
              {pillar.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
