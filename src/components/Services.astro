---
// Services.astro — Sección "Servicios"
import { services } from "../data/company";
import SectionHeading from "./SectionHeading.astro";
import ServiceRow from "./ServiceRow.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
---

<section
  id="servicios"
  class="relative isolate overflow-clip bg-primary-950 py-24 md:py-36"
  aria-labelledby="servicios-title"
>
  <!-- Halo de fondo -->
  <div
    class="glow absolute -top-40 -right-72 -z-10 size-160 opacity-50"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <SectionHeading
      id="servicios-title"
      eyebrow="01 — Servicios"
      title="Software que se adapta a tu negocio."
      description="Construimos exactamente lo que tu negocio necesita, con el stack tecnológico más adecuado para cada proyecto."
      layout="split"
    />

    <ul class="mt-16 border-b border-white/10 md:mt-24">
      {
        services.map((service) => (
          <ServiceRow service={service} />
        ))
      }
    </ul>

    <div
      class="mt-12 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <p class="text-lg text-primary-400">
        ¿Tienes una idea que no encaja en estas categorías?
      </p>
      <a href="#contacto" class="btn btn-primary self-start sm:self-auto">
        Cuéntanos
        <ArrowRightIcon class="size-5" />
      </a>
    </div>
  </div>
</section>
