---
// Process.astro — Sección "Proceso" (título fijo + pasos que se recorren con el scroll)
import { processSteps } from "../data/company";
import SectionHeading from "./SectionHeading.astro";
---

<section
  id="proceso"
  class="relative isolate overflow-clip bg-primary-950 py-24 md:py-36"
  aria-labelledby="proceso-title"
>
  <!-- Halo de fondo -->
  <div class="bg-grid-dark absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="glow absolute top-1/4 -left-80 -z-10 size-180 opacity-50" aria-hidden="true"></div>

  <div class="container-page grid gap-16 lg:grid-cols-[1fr_1.15fr] lg:gap-24">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHeading
        id="proceso-title"
        eyebrow="03 — Proceso"
        title="Un proceso claro de principio a fin"
        description="Desde la primera conversación hasta la puesta en producción, sabes en todo momento qué estamos haciendo, cuánto cuesta y cuándo se entrega."
      />
    </div>

    <div class="relative pl-8 md:pl-12" data-process>
      <!-- Línea de progreso: base gris + relleno naranja ligado al scroll -->
      <div class="absolute inset-y-0 left-0 w-px bg-white/10" aria-hidden="true"></div>
      <div
        data-progress="y"
        class="absolute inset-y-0 left-0 w-px origin-top bg-linear-to-b from-secondary to-secondary/50"
        aria-hidden="true"
      >
      </div>

      <ol class="space-y-16 md:space-y-24">
        {
          processSteps.map((step, index) => (
            <li class="process-step" data-step data-reveal>
              <span class="process-number font-display text-6xl leading-none font-bold md:text-7xl">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-6 text-2xl text-white md:text-3xl">{step.title}</h3>
              <p class="mt-3 max-w-md text-lg leading-relaxed text-primary-400">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Número en contorno; se rellena de naranja cuando el paso está activo */
  .process-number {
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.25);
    transition:
      color 0.5s ease,
      -webkit-text-stroke-color 0.5s ease;
  }

  .process-step.is-active .process-number {
    color: var(--color-secondary);
    -webkit-text-stroke-color: var(--color-secondary);
  }
</style>
