---
// Process.astro — Sección "Proceso"
import { processSteps } from "../data/company";
import SectionHeading from "./SectionHeading.astro";
---

<section
  id="proceso"
  class="relative isolate overflow-hidden bg-primary-900 py-24 md:py-32"
  aria-labelledby="proceso-title"
>
  <div class="bg-grid-dark absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="glow absolute -bottom-64 -left-48 -z-10 size-160 opacity-60"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <SectionHeading
      id="proceso-title"
      eyebrow="03 — Proceso"
      title="Un proceso claro de principio a fin"
      description="Desde la primera conversación hasta la puesta en producción, sabes en todo momento qué estamos haciendo, cuánto cuesta y cuándo se entrega."
      tone="dark"
    />

    <ol
      class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-2 lg:grid-cols-4"
    >
      {
        processSteps.map((step, index) => (
          <li
            class="group bg-primary-900 p-7 transition-colors duration-300 hover:bg-primary-800 md:p-8"
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm text-secondary">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span
                class="h-px flex-1 bg-white/10 transition-colors group-hover:bg-secondary/40"
                aria-hidden="true"
              />
            </div>
            <h3 class="mt-6 text-xl text-white">{step.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-primary-300">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
