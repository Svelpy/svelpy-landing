---
// Footer.astro — Footer de Svelpy
import {
  companyInfo,
  services,
  socialLinks,
  whatsappUrl,
} from "../data/company";
import Logo from "./Logo.astro";
import FacebookIcon from "./icons/FacebookIcon.astro";
import InstagramIcon from "./icons/InstagramIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import TiktikIcon from "./icons/TiktikIcon.astro";

const year = new Date().getFullYear();

const socialIcons = {
  linkedin: LinkedInIcon,
  instagram: InstagramIcon,
  facebook: FacebookIcon,
  tiktok: TiktikIcon,
};

const columns = [
  {
    title: "Servicios",
    links: services.map((service) => ({
      label: service.title,
      href: "/#servicios",
    })),
  },
  {
    title: "Empresa",
    links: [
      { label: "Modelos de trabajo", href: "/#modelos" },
      { label: "Proceso", href: "/#proceso" },
      { label: "Casos de éxito", href: "/#casos" },
      { label: "Nosotros", href: "/#nosotros" },
      { label: "Preguntas frecuentes", href: "/#faq" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Política de Privacidad", href: "/privacidad" },
      { label: "Términos y Condiciones", href: "/terminos" },
      { label: "Política de Cookies", href: "/cookies" },
    ],
  },
];
---

<footer
  class="relative isolate overflow-hidden bg-primary-950 text-primary-300"
>
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_2.3fr] lg:gap-16">
      <!-- Marca -->
      <div class="max-w-sm">
        <a href="/" aria-label="Svelpy — inicio" class="inline-block">
          <Logo variant="light" class="h-8 w-auto" loading="lazy" />
        </a>
        <p class="mt-6 leading-relaxed">{companyInfo.description}</p>
        <ul class="mt-6 flex gap-2">
          {
            socialLinks.map((link) => {
              const Icon = socialIcons[link.id];
              return (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    class="inline-flex size-10 items-center justify-center rounded-lg border border-white/10 text-primary-300 transition-colors hover:border-secondary hover:bg-secondary hover:text-primary-950"
                  >
                    <Icon class="size-5" />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- Columnas -->
      <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 md:grid-cols-4">
        {
          columns.map((column) => (
            <nav aria-label={column.title}>
              <p class="font-mono text-xs tracking-[0.14em] text-primary-400 uppercase">
                {column.title}
              </p>
              <ul class="mt-5 space-y-3 text-sm">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="transition-colors hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }

        <div>
          <p
            class="font-mono text-xs tracking-[0.14em] text-primary-400 uppercase"
          >
            Contacto
          </p>
          <ul class="mt-5 space-y-3 text-sm">
            <li>
              <a
                href={`mailto:${companyInfo.email}`}
                class="transition-colors hover:text-white"
                >{companyInfo.email}</a
              >
            </li>
            <li>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-white"
                >{companyInfo.whatsapp}</a
              >
            </li>
            <li>{companyInfo.location}</li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {companyInfo.name}. Todos los derechos reservados.</p>
      <p class="font-mono text-xs text-primary-400">{companyInfo.tagline}</p>
    </div>
  </div>
</footer>
