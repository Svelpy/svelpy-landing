---
// Hero.astro
import { companyInfo } from "../data/company";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import IsotipoMark from "./icons/IsotipoMark.astro";

const [sloganStart, sloganEnd] = companyInfo.slogan.split(
  companyInfo.sloganHighlight,
);

// Ventana de terminal decorativa
const terminalSteps = [
  { label: "Descubrimiento y alcance", time: "sem 1" },
  { label: "Diseño UI/UX", time: "sem 2" },
  { label: "Desarrollo por sprints", time: "sem 3–10" },
  { label: "Pruebas y control de calidad", time: "continuo" },
];
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-primary-950 pt-32 pb-24 md:pt-40 md:pb-32"
>
  <!-- Fondo -->
  <div class="bg-grid-dark absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="glow absolute -top-48 right-[-15%] -z-10 size-176"
    aria-hidden="true"
  >
  </div>
  <IsotipoMark
    variant="light"
    class="absolute -bottom-40 -left-40 -z-10 hidden w-136 opacity-5 lg:block"
  />

  <div
    class="container-page grid items-center gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12"
  >
    <div>
      <h1
        class="animate-fade-in text-[2.6rem] leading-[1.04] text-white sm:text-6xl xl:text-7xl"
      >
        {sloganStart}<span class="text-secondary"
          >{companyInfo.sloganHighlight}</span
        >{sloganEnd}
      </h1>

      <p
        class="animate-fade-in mt-6 max-w-xl text-lg leading-relaxed text-primary-300 [animation-delay:100ms] md:text-xl"
      >
        {companyInfo.description}
      </p>

      <div
        class="animate-fade-in mt-10 flex flex-col gap-3 [animation-delay:200ms] sm:flex-row"
      >
        <a href="#contacto" class="btn btn-primary">
          Agenda una reunión
          <ArrowRightIcon class="size-5" />
        </a>
        <a href="#servicios" class="btn btn-ghost">Ver servicios</a>
      </div>

    </div>

    <!-- Terminal -->
    <div
      class="animate-fade-in relative [animation-delay:200ms]"
      aria-hidden="true"
    >
      <div class="glow absolute inset-6 -z-10 opacity-70"></div>
      <div
        class="overflow-hidden rounded-2xl border border-white/10 bg-primary-900/80 shadow-2xl shadow-black/40 backdrop-blur"
      >
        <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
          <span class="size-3 rounded-full bg-secondary/80"></span>
          <span class="size-3 rounded-full bg-white/15"></span>
          <span class="size-3 rounded-full bg-white/15"></span>
          <span class="ml-3 font-mono text-xs text-primary-400"
            >svelpy — ~/tu-proyecto</span
          >
        </div>
        <div
          class="space-y-3 p-5 font-mono text-[13px] leading-relaxed sm:p-7 sm:text-sm"
        >
          <p class="text-primary-400">{companyInfo.tagline}</p>
          <p class="text-white">
            <span class="text-secondary">$</span> svelpy init tu-proyecto
          </p>
          {
            terminalSteps.map((step) => (
              <p class="flex items-center justify-between gap-4">
                <span class="text-primary-200">
                  <span class="text-secondary">✓</span> {step.label}
                </span>
                <span class="shrink-0 text-primary-400">{step.time}</span>
              </p>
            ))
          }
          <p class="flex items-center justify-between gap-4">
            <span class="text-white">
              <span class="text-secondary">→</span> Desplegado en producción
            </span>
            <span
              class="shrink-0 rounded bg-secondary/15 px-1.5 py-0.5 text-xs text-secondary"
              >live</span
            >
          </p>
          <p class="text-white">
            <span class="text-secondary">$</span>
            <span
              class="animate-blink inline-block h-4 w-2 translate-y-0.5 bg-secondary"
            ></span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
