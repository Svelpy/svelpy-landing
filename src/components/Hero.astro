---
// Hero.astro
import { companyInfo } from "../data/company";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";

const [sloganStart, sloganEnd] = companyInfo.slogan.split(
  companyInfo.sloganHighlight,
);
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-primary-950 pt-36 pb-20 md:pt-48 md:pb-28"
>
  <!-- Fondo -->
  <div
    class="glow absolute -top-72 left-1/2 -z-10 h-136 w-[280] -translate-x-1/2 opacity-40"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <h1
      class="animate-fade-in mt-8 max-w-6xl text-[clamp(2.75rem,8vw,6.75rem)] leading-[0.98] font-medium tracking-[-0.045em] text-white [animation-delay:80ms]"
    >
      {sloganStart}<span class="text-secondary"
        >{companyInfo.sloganHighlight}</span
      >{sloganEnd}<span
        class="animate-blink ml-[0.08em] inline-block h-[0.78em] w-[0.09em] translate-y-[0.06em] bg-secondary"
        aria-hidden="true"></span>
    </h1>

    <div
      class="animate-fade-in mt-10 flex flex-col gap-8 [animation-delay:160ms] lg:flex-row lg:items-end lg:justify-between"
    >
      <p class="max-w-xl text-base leading-relaxed text-primary-400 md:text-lg">
        {companyInfo.description}
      </p>

      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a href="#contacto" class="btn btn-primary">
          Agenda una reunión
          <ArrowRightIcon class="size-5" />
        </a>
        <a href="#servicios" class="btn btn-ghost">Ver servicios</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pipeline {
    --step: 0.5s;
    --start: 0.7s;
  }

  .pipeline-step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 1rem;
    padding-bottom: 1.75rem;

    @media (min-width: 768px) {
      grid-template-columns: 1fr;
      row-gap: 0.25rem;
      padding-bottom: 0;
      padding-right: 1.5rem;
    }
  }

  /* Tramo de línea hasta la siguiente etapa: base + relleno naranja */
  .pipeline-step:not([data-last])::before,
  .pipeline-step:not([data-last])::after {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0;
    left: 5px;
    width: 1px;

    @media (min-width: 768px) {
      top: 5px;
      bottom: auto;
      left: 0.75rem;
      right: 0;
      width: auto;
      height: 1px;
    }
  }

  .pipeline-step:not([data-last])::before {
    background-color: rgb(255 255 255 / 0.1);
  }

  .pipeline-step:not([data-last])::after {
    background: linear-gradient(
      to bottom,
      var(--color-secondary),
      rgb(255 71 36 / 0.7)
    );
    transform-origin: top;
    animation: fill-y var(--step) linear
      calc(var(--start) + var(--i) * var(--step)) both;

    @media (min-width: 768px) {
      background: linear-gradient(
        to right,
        var(--color-secondary),
        rgb(255 71 36 / 0.7)
      );
      transform-origin: left;
      animation-name: fill-x;
    }
  }

  .pipeline-node {
    position: relative;
    z-index: 1;
    width: 11px;
    height: 11px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 3px;
    background-color: var(--color-primary-950);
    animation: node-on 0.3s ease-out calc(var(--start) + var(--i) * var(--step))
      both;

    @media (min-width: 768px) {
      margin-bottom: 1rem;
    }
  }

  .pipeline-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    animation: label-on 0.3s ease-out
      calc(var(--start) + var(--i) * var(--step)) both;
  }

  .pipeline-time,
  .pipeline-live {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary-400);
  }

  .pipeline-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    background-color: rgb(255 71 36 / 0.15);
    color: var(--color-secondary);
    animation: fade-in 0.3s ease-out calc(var(--start) + var(--i) * var(--step))
      both;
  }

  .pipeline-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--color-secondary);
    animation: live-pulse 1.6s ease-in-out infinite;
  }

  @keyframes fill-y {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes fill-x {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes node-on {
    from {
      border-color: rgb(255 255 255 / 0.25);
      background-color: var(--color-primary-950);
      box-shadow: none;
    }
    to {
      border-color: var(--color-secondary);
      background-color: var(--color-secondary);
      box-shadow: 0 0 14px 2px rgb(255 71 36 / 0.55);
    }
  }

  @keyframes label-on {
    from {
      color: var(--color-primary-400);
    }
    to {
      color: var(--color-neutral);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes live-pulse {
    50% {
      opacity: 0.3;
    }
  }
</style>
