---
// Faq.astro — Sección "Preguntas frecuentes"
import { companyInfo, faqs } from "../data/company";
import SectionHeading from "./SectionHeading.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import PlusIcon from "./icons/PlusIcon.astro";
---

<section
  id="faq"
  class="relative isolate overflow-clip border-y border-white/10 bg-primary-900 py-24 md:py-36"
  aria-labelledby="faq-title"
>
  <!-- Halo de fondo -->
  <div class="glow absolute -top-60 -left-72 -z-10 size-160 opacity-40" aria-hidden="true"></div>

  <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div>
      <SectionHeading
        id="faq-title"
        eyebrow="06 — Preguntas frecuentes"
        title="Resolvemos tus dudas antes de empezar"
      />
      <p class="mt-6 text-primary-400" data-reveal>
        ¿Tienes otra pregunta?
        <a
          href={`mailto:${companyInfo.email}`}
          class="inline-flex items-center gap-1 font-semibold text-white underline decoration-secondary decoration-2 underline-offset-4 transition-colors hover:text-secondary"
        >
          Escríbenos
          <ArrowRightIcon class="size-4" />
        </a>
      </p>
    </div>

    <div class="divide-y divide-white/10 border-y border-white/10" data-reveal>
      {
        faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-left">
              <span class="font-display text-xl font-bold text-white transition-colors group-hover:text-secondary md:text-2xl">
                {faq.question}
              </span>
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-white/10 bg-primary-950 text-primary-300 transition duration-300 group-open:rotate-45 group-open:border-secondary group-open:bg-secondary group-open:text-primary-950">
                <PlusIcon class="size-4" />
              </span>
            </summary>
            <p data-faq-content class="max-w-2xl pb-6 leading-relaxed text-primary-400">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item summary {
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
