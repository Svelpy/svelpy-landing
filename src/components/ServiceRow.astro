---
// ServiceRow.astro — Fila de servicio
import type { Service } from "../data/company";
import { icons } from "./icons";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const Icon = icons[service.icon];
---

<li
  class="grid gap-4 border-t border-white/10 py-8 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-8 md:py-10"
  data-reveal
>
  <h3
    class="flex items-center gap-4 text-3xl leading-tight text-white md:text-4xl"
  >
    <Icon class="size-7 shrink-0 text-secondary md:size-8" />
    {service.title}
  </h3>

  <p class="max-w-lg leading-relaxed text-primary-400">
    {service.description}
  </p>
</li>
