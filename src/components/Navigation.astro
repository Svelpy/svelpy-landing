---
//Navigation.astro
import Logo from "./Logo.astro";

const navItems = [
  { href: "#servicios", label: "Servicios" },
  { href: "#modelos", label: "Modelos" },
  { href: "#proceso", label: "Proceso" },
  { href: "#casos", label: "Casos" },
  { href: "#nosotros", label: "Nosotros" },
];
---

<header
  id="site-header"
  data-scrolled="false"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-primary-950/95 data-[scrolled=true]:backdrop-blur-lg"
>
  <nav
    class="container-page flex h-16 items-center justify-between gap-6 md:h-18"
    aria-label="Principal"
  >
    <a href="#hero" class="shrink-0" aria-label="Svelpy — ir al inicio">
      <Logo variant="light" class="h-7 w-auto md:h-8" />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link relative rounded-md px-3 py-2 text-sm font-medium text-primary-300 transition-colors hover:text-white aria-[current=true]:text-white"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href="#contacto" class="btn btn-primary btn-sm hidden sm:inline-flex">
        Contáctanos
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-lg text-white transition-colors hover:bg-white/10 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path class="menu-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="menu-icon-close hidden" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-primary-950/95 backdrop-blur-lg lg:hidden"
  >
    <ul class="container-page flex flex-col gap-1 py-4">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-link block rounded-lg px-3 py-3 text-base font-medium text-primary-200 transition-colors hover:bg-white/5 hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="px-3 pt-3">
        <a href="#contacto" class="mobile-link btn btn-primary w-full">
          Contáctanos
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-secondary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link[aria-current="true"]::after {
    transform: scaleX(1);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  let menuOpen = false;

  const syncHeader = () => {
    if (header) {
      header.dataset.scrolled = String(window.scrollY > 8 || menuOpen);
    }
  };

  const setMenu = (open: boolean) => {
    menuOpen = open;
    menu?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    toggle?.querySelector(".menu-icon-open")?.classList.toggle("hidden", open);
    toggle?.querySelector(".menu-icon-close")?.classList.toggle("hidden", !open);
    syncHeader();
  };

  toggle?.addEventListener("click", () => setMenu(!menuOpen));

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuOpen) {
      setMenu(false);
      toggle?.focus();
    }
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });

  window.addEventListener("scroll", syncHeader, { passive: true });
  syncHeader();

  // Resaltar el link de la sección visible
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = `#${entry.target.id}`;
        navLinks.forEach((link) => {
          link.setAttribute("aria-current", String(link.hash === id));
        });
      });
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );

  document.querySelectorAll("main section[id]").forEach((section) => {
    sectionObserver.observe(section);
  });
</script>
