---
// ServiceCard.astro — Card de servicio
import type { Service } from "../data/company";
import { icons } from "./icons";

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const Icon = icons[service.icon];
---

<article
  class="group flex flex-col rounded-2xl bg-primary-900 p-7 transition-colors duration-300 hover:border-secondary/50 md:p-9"
  data-reveal
  style={`--reveal-delay: ${(index % 2) * 90}ms`}
>
  <div class="flex items-center gap-4">
    <span
      class="inline-flex size-12 items-center justify-center rounded-xl bg-secondary/10 text-secondary ring-1 ring-secondary/20 transition-colors duration-300 group-hover:bg-secondary group-hover:text-primary-950 group-hover:ring-secondary"
    >
      <Icon class="size-6" />
    </span>
    <h3 class="text-lg md:text-2xl text-white">{service.title}</h3>
  </div>

  <p class="mt-3 leading-relaxed text-primary-400">{service.description}</p>
</article>
