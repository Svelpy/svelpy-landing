---
// ServiceCard.astro — Card de servicio
import type { Service } from "../data/company";
import { icons } from "./icons";

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const Icon = icons[service.icon];
---

<article
  class="group flex flex-col rounded-2xl border border-primary-200 bg-white p-7 transition-colors duration-300 hover:border-secondary/50 md:p-9"
  data-reveal
  style={`--reveal-delay: ${(index % 2) * 90}ms`}
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="inline-flex size-12 items-center justify-center rounded-xl bg-secondary-50 text-secondary-600 ring-1 ring-secondary-100 transition-colors duration-300 group-hover:bg-secondary group-hover:text-primary-950 group-hover:ring-secondary"
    >
      <Icon class="size-6" />
    </span>
    <span class="font-mono text-xs tracking-wider text-primary-600">
      {String(index + 1).padStart(2, "0")}
    </span>
  </div>

  <h3 class="mt-8 text-2xl text-primary-900">{service.title}</h3>
  <p class="mt-3 leading-relaxed text-primary-600">{service.description}</p>
</article>
