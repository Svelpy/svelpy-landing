---
// Contact.astro — Sección "Contacto"
import { companyInfo, services, whatsappUrl } from "../data/company";
import MailIcon from "./icons/MailIcon.astro";
import MapPinIcon from "./icons/MapPinIcon.astro";
import WhatsappIcon from "./icons/WhatsappIcon.astro";

const serviceOptions = [
  ...services.map((service) => service.title),
  "Suscripción a una plataforma SaaS",
  "Plan de alojamiento y soporte",
  "Otro",
];

const channels = [
  {
    label: "Email",
    hint: "Consultas y presupuestos",
    value: companyInfo.email,
    href: `mailto:${companyInfo.email}`,
    icon: MailIcon,
    external: false,
  },
  {
    label: "WhatsApp",
    hint: "Atención directa",
    value: companyInfo.whatsapp,
    href: whatsappUrl,
    icon: WhatsappIcon,
    external: true,
  },
];

const nextSteps = [
  "Revisamos tu mensaje y te contactamos.",
  "Agendamos una reunión para entender tu necesidad.",
  "Recibes una propuesta con alcance, cronograma e inversión.",
];

const fieldClass =
  "w-full rounded-lg border border-white/10 bg-primary-950 px-4 py-3 text-white placeholder:text-primary-500 outline-none transition focus:border-secondary focus:ring-4 focus:ring-secondary/15";
const labelClass = "mb-2 block text-sm font-medium text-white";
---

<section
  id="contacto"
  class="bg-primary-950 py-24 md:py-32"
  aria-labelledby="contacto-title"
>
  <div class="container-page">
    <div
      class="grid overflow-hidden rounded-3xl md:border md:border-white/10 shadow-[0_40px_80px_-40px_rgb(42_24_45/0.35)] lg:grid-cols-[0.85fr_1.15fr]"
      data-reveal
    >
      <!-- Panel informativo -->
      <div
        class="relative isolate flex flex-col overflow-hidden bg-primary-950 md:p-8 py-8 lg:p-12"
      >
        <div class="bg-grid-dark absolute inset-0 -z-10" aria-hidden="true">
        </div>
        <div
          class="glow absolute right-0 -bottom-40 -z-10 size-112"
          aria-hidden="true"
        >
        </div>

        <p class="text-secondary">07 — Contacto</p>
        <h2
          id="contacto-title"
          class="mt-4 text-3xl leading-[1.1] text-white sm:text-4xl md:text-5xl"
        >
          ¿Tienes un proyecto en mente?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-primary-300">
          Cuéntanos tu idea y te contactaremos para conocer los detalles de tu
          proyecto.
        </p>

        <ul class="mt-10 space-y-3">
          {
            channels.map((channel) => (
              <li>
                <a
                  href={channel.href}
                  {...(channel.external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                  class="group flex items-center gap-4 rounded-xl border border-white/10 bg-white/3 p-4 transition-colors hover:border-white/20 hover:bg-white/7"
                >
                  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg bg-secondary text-primary-950">
                    <channel.icon class="size-5" />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-mono text-[11px] tracking-[0.14em] text-primary-400 uppercase">
                      {channel.label}
                      <span class="hidden sm:inline"> · {channel.hint}</span>
                    </span>
                    <span class="mt-0.5 block truncate text-white">
                      {channel.value}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
          <li
            class="flex items-center gap-4 rounded-xl border border-white/10 bg-white/3 p-4"
          >
            <span
              class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg bg-white/10 text-white"
            >
              <MapPinIcon class="size-5" />
            </span>
            <span>
              <span
                class="block font-mono text-[11px] tracking-[0.14em] text-primary-400 uppercase"
                >Ubicación</span
              >
              <span class="mt-0.5 block text-white">{companyInfo.location}</span
              >
            </span>
          </li>
        </ul>
      </div>

      <!-- Formulario de contacto -->
      <div class="md:bg-primary-900 md:p-8 lg:p-12">
        <h3 class="text-2xl text-white md:text-3xl">Hablemos de tu proyecto</h3>
        <p class="mt-3 text-primary-400">
          Completa el formulario y te contactaremos para conocer mejor lo que
          necesita tu empresa.
        </p>

        <form
          id="contact-form"
          action="/api/contact"
          method="POST"
          accept-charset="UTF-8"
          data-email={companyInfo.email}
          class="relative mt-8 grid grid-cols-1 gap-5 md:grid-cols-2"
        >
          <!-- Honeypot: los usuarios no deben completar este campo. -->
          <div class="absolute -left-2500" aria-hidden="true">
            <label for="company-website">Sitio web</label>
            <input
              id="company-website"
              type="text"
              name="_honey"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div>
            <label for="contact-name" class={labelClass}>
              Nombre y apellido <span class="text-secondary" aria-hidden="true"
                >*</span
              >
            </label>
            <input
              id="contact-name"
              name="nombre"
              type="text"
              autocomplete="name"
              minlength="2"
              maxlength="80"
              required
              placeholder="Ej. Andrea Pérez"
              class={fieldClass}
            />
          </div>

          <div>
            <label for="contact-company" class={labelClass}>
              Empresa <span class="font-normal text-primary-500"
                >(opcional)</span
              >
            </label>
            <input
              id="contact-company"
              name="empresa"
              type="text"
              autocomplete="organization"
              maxlength="100"
              placeholder="Nombre de tu empresa"
              class={fieldClass}
            />
          </div>

          <div>
            <label for="contact-email-input" class={labelClass}>
              Email <span class="text-secondary" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-email-input"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
              placeholder="nombre@empresa.com"
              class={fieldClass}
            />
          </div>

          <div>
            <label for="contact-phone" class={labelClass}>
              Teléfono <span class="text-secondary" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-phone"
              name="telefono"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              minlength="7"
              maxlength="25"
              required
              placeholder="Ej. +591 70000000"
              class={fieldClass}
            />
          </div>

          <div class="md:col-span-2">
            <label for="contact-service" class={labelClass}>
              ¿Qué solución necesitas? <span
                class="text-secondary"
                aria-hidden="true">*</span
              >
            </label>
            <div class="relative">
              <select
                id="contact-service"
                name="tipo_de_proyecto"
                required
                class={`${fieldClass} appearance-none pr-11`}
              >
                <option value="" selected disabled>Selecciona una opción</option
                >
                {
                  serviceOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-primary-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M6 9l6 6l6 -6"></path></svg
              >
            </div>
          </div>

          <div class="md:col-span-2">
            <label for="contact-details" class={labelClass}>
              Detalles del proyecto <span class="font-normal text-primary-500"
                >(opcional)</span
              >
            </label>
            <textarea
              id="contact-details"
              name="detalles"
              rows="5"
              maxlength="2000"
              aria-describedby="details-help"
              placeholder="Cuéntanos sobre tu empresa, el problema que quieres resolver, objetivos y plazos aproximados."
              class={`${fieldClass} resize-y`}></textarea>
            <p id="details-help" class="mt-2 text-xs text-primary-400">
              No incluyas contraseñas ni información confidencial.
            </p>
          </div>

          <div class="md:col-span-2">
            <label class="flex cursor-pointer items-start gap-3">
              <input
                type="checkbox"
                name="acepta_privacidad"
                value="Sí"
                required
                class="mt-0.5 size-4 shrink-0 accent-secondary"
              />
              <span class="text-sm text-primary-400">
                He leído y acepto la <a
                  href="/privacidad"
                  class="font-medium text-white underline underline-offset-4 hover:text-secondary"
                  >política de privacidad</a
                > y autorizo el uso de mis datos para responder esta consulta.
                <span class="text-secondary" aria-hidden="true">*</span>
              </span>
            </label>
          </div>

          <div
            class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center md:col-span-2"
          >
            <button
              id="contact-submit"
              type="submit"
              class="btn btn-primary w-full disabled:cursor-wait disabled:opacity-70 sm:w-auto sm:min-w-56"
            >
              Enviar consulta
            </button>
            <p class="text-xs text-primary-400">
              Los campos marcados con * son obligatorios.
            </p>
          </div>

          <p
            id="contact-status"
            class="min-h-6 text-sm text-primary-400 md:col-span-2"
            role="status"
            aria-live="polite"
          >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const submitButton =
    document.querySelector<HTMLButtonElement>("#contact-submit");
  const status =
    document.querySelector<HTMLParagraphElement>("#contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!submitButton || !status) return;

    const defaultButtonText = submitButton.textContent;
    submitButton.disabled = true;
    submitButton.textContent = "Enviando…";
    status.textContent = "Enviando tu consulta…";
    status.className = "min-h-6 text-sm text-primary-400 md:col-span-2";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });

      if (!response.ok) throw new Error("No se pudo enviar el formulario");

      form.reset();
      status.textContent =
        "¡Gracias! Recibimos tu consulta y te responderemos pronto.";
      status.className =
        "min-h-6 text-sm font-semibold text-white md:col-span-2";
    } catch {
      const email = form.dataset.email;
      status.innerHTML = `No pudimos enviar el mensaje. Inténtalo de nuevo o escríbenos a <a class="underline font-semibold" href="mailto:${email}">${email}</a>.`;
      status.className =
        "min-h-6 text-sm font-semibold text-secondary md:col-span-2";
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = defaultButtonText;
    }
  });
</script>
