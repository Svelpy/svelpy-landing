---
// SectionHeading.astro — Etiqueta + título + descripción de cada sección
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  // "split": título grande a la izquierda y descripción en una columna a la derecha
  layout?: "stack" | "split";
}

const {
  id,
  eyebrow,
  title,
  description,
  align = "left",
  layout = "stack",
} = Astro.props;
const split = layout === "split";
---

<div
  class:list={[
    split
      ? "grid gap-6 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:gap-16"
      : "max-w-3xl",
    !split && align === "center" && "mx-auto text-center",
  ]}
  data-heading
>
  <div>
    <p class="eyebrow text-secondary">{eyebrow}</p>
    <h2
      id={id}
      data-split
      class="mt-5 text-4xl leading-[1.02] tracking-[-0.035em] text-white sm:text-5xl lg:text-6xl"
    >
      {title}
    </h2>
  </div>
  {
    description && (
      <p
        data-heading-text
        class:list={[
          "text-lg leading-relaxed text-primary-400",
          split ? "max-w-md lg:pb-2" : "mt-6",
        ]}
      >
        {description}
      </p>
    )
  }
</div>
