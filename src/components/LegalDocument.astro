---
// LegalDocument.astro — Encabezado, secciones y CTA de una página legal
import { companyInfo } from "../data/company";
import type { LegalPage } from "../data/legal";

interface Props {
  page: LegalPage;
  cta: {
    question: string;
    label: string;
    subject: string;
  };
}

const { page, cta } = Astro.props;
const mailto = `mailto:${companyInfo.email}?subject=${encodeURIComponent(cta.subject)}`;
---

<header
  class="relative isolate overflow-hidden bg-primary-950 pt-32 pb-16 md:pt-40 md:pb-20"
>
  <div class="bg-grid-dark absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="glow absolute -top-48 right-[-10%] -z-10 size-160"
    aria-hidden="true"
  >
  </div>

  <div class="container-page max-w-4xl">
    <nav aria-label="Ruta de navegación" class="font-mono text-xs text-primary-400">
      <a href="/" class="transition-colors hover:text-white">Inicio</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-secondary" aria-current="page">{page.title}</span>
    </nav>
    <h1 class="mt-6 text-4xl leading-[1.05] text-white md:text-6xl">
      {page.title}
    </h1>
    <p
      class="mt-6 inline-flex rounded-full border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-xs text-primary-300"
    >
      Última actualización: {page.lastUpdated}
    </p>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-primary-300">
      {page.intro}
    </p>
  </div>
</header>

<div class="container-page max-w-4xl py-16 md:py-24">
  <slot name="before" />

  <div class="space-y-12">
    {
      page.sections.map((section) => (
        <section class="border-l-2 border-primary-100 pl-6 transition-colors hover:border-secondary md:pl-8">
          <h2 class="text-xl text-primary-900 md:text-2xl">{section.title}</h2>
          <ul class="mt-4 space-y-3">
            {section.content.map((item) => (
              <li class="flex gap-3 leading-relaxed text-primary-700">
                <span
                  class="mt-2.5 size-1.5 shrink-0 rounded-full bg-secondary"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <slot />

  <!-- CTA de contacto -->
  <div
    class="relative isolate mt-12 flex flex-col items-start justify-between gap-6 overflow-hidden rounded-2xl bg-primary-900 p-8 sm:flex-row sm:items-center md:p-10"
  >
    <div class="bg-grid-dark absolute inset-0 -z-10" aria-hidden="true"></div>
    <p class="font-display text-xl font-bold text-white md:text-2xl">
      {cta.question}
    </p>
    <a href={mailto} class="btn btn-primary shrink-0">{cta.label}</a>
  </div>
</div>
