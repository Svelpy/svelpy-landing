---
// ClientCard.astro — Logo de cliente (monocromo sobre fondo oscuro)
import type { Client } from "../data/company";

interface Props {
  client: Client;
  index: number;
}

const { client, index } = Astro.props;
---

<a
  href={client.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-center justify-center"
  data-reveal
  style={`--reveal-delay: ${index * 90}ms`}
  aria-label={`${client.company} — visitar sitio (se abre en una pestaña nueva)`}
>
  <img
    src={client.logo}
    alt=""
    class="h-16 w-40 object-contain opacity-75 brightness-0 invert transition-opacity duration-300 group-hover:opacity-100 md:h-20 md:w-48"
    loading="lazy"
    decoding="async"
  />
</a>
