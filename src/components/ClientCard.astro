---
// ClientCard.astro — Logo de cliente en la franja de casos (monocromo sobre fondo oscuro)
import type { Client } from "../data/company";

interface Props {
  client: Client;
}

const { client } = Astro.props;
---

<div
  class="flex h-full items-center justify-center bg-primary-900 px-8 py-14 md:py-20"
  data-reveal
>
  <img
    src={client.logo}
    alt=""
    class="h-20 w-48 object-contain opacity-80 brightness-0 invert md:h-24 md:w-56"
    loading="lazy"
    decoding="async"
  />
</div>
