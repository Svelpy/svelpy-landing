---
// terminos.astro — Términos y Condiciones
import LegalLayout from "../layouts/LegalLayout.astro";
import LegalDocument from "../components/LegalDocument.astro";
import { termsOfService } from "../data/legal";
---

<LegalLayout
  title={termsOfService.title}
  description="Términos y condiciones de uso de los servicios de Svelpy. Información sobre contratación, pagos, garantías y propiedad intelectual."
>
  <LegalDocument
    page={termsOfService}
    cta={{
      question: "¿Tienes dudas antes de contratar?",
      label: "Hablemos antes de comenzar",
      subject: "Consulta Términos de Servicio",
    }}
  >
    <!-- Aviso de aceptación -->
    <div
      class="mt-12 rounded-2xl border border-white/10 bg-primary-900 p-6 md:p-8"
    >
      <p class="leading-relaxed text-primary-300">
        <strong class="font-display text-white"
          >Aceptación de los Términos:</strong
        > Al contratar los servicios de Svelpy o al navegar este sitio web, confirmas
        que has leído, entendido y aceptado estos términos y condiciones en su
        totalidad.
      </p>
    </div>
  </LegalDocument>
</LegalLayout>
