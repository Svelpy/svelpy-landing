---
// cookies.astro — Política de Cookies
import LegalLayout from "../layouts/LegalLayout.astro";
import LegalDocument from "../components/LegalDocument.astro";
import { cookiesPolicy } from "../data/legal";

const summary = [
  { type: "Esenciales", purpose: "Funcionamiento del sitio", duration: "Sesión" },
  { type: "Análisis", purpose: "Google Analytics (anónimo)", duration: "Hasta 2 años" },
  { type: "Preferencias", purpose: "Configuración del usuario", duration: "30 días" },
];
---

<LegalLayout
  title={cookiesPolicy.title}
  description="Política de cookies de Svelpy. Conoce qué cookies usamos y cómo puedes gestionarlas."
>
  <LegalDocument
    page={cookiesPolicy}
    cta={{
      question: "¿Preguntas sobre nuestras cookies?",
      label: "Contáctanos",
      subject: "Consulta Política de Cookies",
    }}
  >
    <!-- Tabla resumen rápida -->
    <div
      slot="before"
      class="mb-14 overflow-hidden rounded-2xl border border-primary-200"
    >
      <h2
        class="border-b border-primary-200 bg-primary-50 px-6 py-4 text-lg text-primary-900"
      >
        Resumen rápido
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="font-mono text-xs tracking-wider text-primary-600 uppercase">
            <tr class="border-b border-primary-100">
              <th class="px-6 py-3 font-medium">Tipo</th>
              <th class="px-6 py-3 font-medium">Propósito</th>
              <th class="px-6 py-3 font-medium">Duración</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-100 text-primary-700">
            {
              summary.map((row) => (
                <tr>
                  <td class="px-6 py-3 font-mono text-secondary-600">{row.type}</td>
                  <td class="px-6 py-3">{row.purpose}</td>
                  <td class="px-6 py-3">{row.duration}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </LegalDocument>
</LegalLayout>
