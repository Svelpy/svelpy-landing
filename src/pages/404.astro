---
// 404.astro — Página de error personalizada
import LegalLayout from "../layouts/LegalLayout.astro";
import IsotipoMark from "../components/icons/IsotipoMark.astro";

const quickLinks = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#modelos", label: "Modelos de trabajo" },
  { href: "/#casos", label: "Casos de éxito" },
  { href: "/#nosotros", label: "Nosotros" },
  { href: "/#contacto", label: "Contacto" },
];
---

<LegalLayout
  title="Página no encontrada"
  description="La página que buscas no existe en Svelpy."
>
  <section
    class="relative isolate flex min-h-svh items-center overflow-hidden bg-primary-950 pt-28 pb-20"
  >
    <div class="bg-grid-dark absolute inset-0 -z-10" aria-hidden="true"></div>
    <div
      class="glow absolute top-1/2 left-1/2 -z-10 size-160 -translate-1/2"
      aria-hidden="true"
    >
    </div>

    <div class="container-page flex flex-col items-center text-center">
      <IsotipoMark variant="light" class="animate-float size-20" />

      <p
        class="mt-10 font-display text-8xl leading-none font-bold tracking-tight text-white md:text-9xl"
      >
        404
      </p>

      <p
        class="mt-6 rounded-lg border border-white/10 bg-white/5 px-4 py-2 font-mono text-sm text-secondary"
      >
        &lt;PaginaNoEncontrada /&gt;
      </p>

      <h1 class="mt-8 text-3xl text-white md:text-4xl">
        Ups, esta página no existe
      </h1>

      <p class="mt-4 max-w-md text-lg leading-relaxed text-primary-300">
        La URL que ingresaste no está en nuestro servidor. Puede haber sido
        movida, eliminada o nunca existió.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">← Volver al inicio</a>
        <a href="/#contacto" class="btn btn-ghost">Contactar a Svelpy</a>
      </div>

      <nav aria-label="Secciones" class="mt-14">
        <p class="font-mono text-xs tracking-[0.14em] text-primary-400 uppercase">
          ¿Buscabas alguna de estas secciones?
        </p>
        <ul class="mt-4 flex flex-wrap justify-center gap-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="chip chip-dark transition-colors hover:border-secondary hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</LegalLayout>
